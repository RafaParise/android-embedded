#!/data/data/com.termux/files/usr/bin/python3
"""ligar-pc: acorda o PC desligado pelo cabo (Wake-on-LAN), a partir do Termux do A12.

Por que existe (19/11/2026): o Moonlight manda o pacote mágico para a rede do celular (192.168.1.x), mas o CABO do
PC fica atrás do FortiGate (10.0.20.x) e, desligado, só a placa de cabo acorda (o Wi-Fi Intel não acorda do
desligamento). Este comando manda o pacote para a porta wan1 do FortiGate, que o repassa à rede do PC (VIP de UDP 9 +
ARP estático de broadcast, aplicados pelo Rafael no console).

Uso:  ligar-pc                 manda o pacote e espera o PC responder (até 3 minutos)
      ligar-pc --sem-esperar   só manda
      ligar-pc --status        mostra a configuração (sem o MAC inteiro)

Configuração (fora do git, só no celular): ~/.config/ligar-pc.json
  {"mac": "AA:BB:CC:DD:EE:FF", "destinos": ["192.168.1.40"], "porta": 9, "pc": "192.168.1.17", "porta_pc": 47989,
   "extras": [{"mac": "11:22:33:44:55:66", "destinos": ["192.168.1.255", "255.255.255.255"]}]}
"extras" = outras placas do mesmo PC (ex.: o Wi-Fi, que acorda o PC SUSPENSO sem passar pelo FortiGate).
Só a biblioteca padrão. Funciona na rede de casa (a mesma do FortiGate); pelos dados móveis não alcança.

Cabo de rede (23/11/2026): com o A12 na porta DMZ do FortiGate (10.0.10.x) o pacote vai direto ao PC na rede do cabo
(regra 11 A12_LIGA_PC_WOL do univo-sync: UDP 9 e ping, com o ARP fixo do PC), além dos destinos do JSON. "pc_cabo"
no JSON muda esse endereço (padrão 10.0.20.100). Para saber se o PC ligou, além do "pc" o comando tenta a Tailscale
do PC ("pc_tailscale", padrão 100.64.0.1): da DMZ a rede de casa fica fechada, a Tailscale do PC não.
"""
import json
import os
import re
import socket
import sys
import time

CONF = os.path.expanduser("~/.config/ligar-pc.json")
MAC_RE = re.compile(r"^[0-9A-Fa-f]{2}([:-][0-9A-Fa-f]{2}){5}$")
IP_RE = re.compile(r"^\d{1,3}(\.\d{1,3}){3}$")
PC_CABO = "10.0.20.100"        # o PC na rede do cabo (reserva do DHCP do FortiGate, univo-sync)
PC_TAILSCALE = "100.64.0.1"  # o PC na tailnet


def ip_local():
    """O IP de saída do celular agora ('' sem rede): só abre o socket UDP, não manda nada."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("10.0.20.1", 9))
            return s.getsockname()[0]
    except OSError:
        return ""


def na_dmz(ip):
    return ip.startswith("10.0.10.")


def ler_conf():
    try:
        with open(CONF, encoding="utf-8") as f:
            c = json.load(f)
    except FileNotFoundError:
        sys.exit(f"falta a configuração {CONF} (veja a ajuda: ligar-pc --help)")
    except ValueError:
        sys.exit(f"{CONF} não é um JSON válido")
    mac = str(c.get("mac", ""))
    if not MAC_RE.match(mac):
        sys.exit("MAC fora do formato em " + CONF)
    destinos = [d for d in c.get("destinos", []) if isinstance(d, str) and IP_RE.match(d)]
    if not destinos:
        sys.exit("nenhum destino válido em " + CONF)
    porta = int(c.get("porta", 9))
    if not 1 <= porta <= 65535:
        sys.exit("porta fora da faixa")
    alvos = [(mac, destinos)]
    for e in c.get("extras", []) if isinstance(c.get("extras"), list) else []:
        m = str(e.get("mac", "")) if isinstance(e, dict) else ""
        ds = [d for d in e.get("destinos", []) if isinstance(d, str) and IP_RE.match(d)] if isinstance(e, dict) else []
        if MAC_RE.match(m) and ds:
            alvos.append((m, ds))
    pc_cabo = c.get("pc_cabo") if isinstance(c.get("pc_cabo"), str) and IP_RE.match(c.get("pc_cabo")) else PC_CABO
    pc_ts = c.get("pc_tailscale") if isinstance(c.get("pc_tailscale"), str) and IP_RE.match(c.get("pc_tailscale")) else PC_TAILSCALE
    pc = c.get("pc") if isinstance(c.get("pc"), str) and IP_RE.match(c.get("pc")) else None
    return {"mac": mac, "destinos": destinos, "porta": porta, "alvos": alvos, "pc_cabo": pc_cabo,
            "pc": pc, "pcs": [p for p in (pc, pc_ts) if p], "porta_pc": int(c.get("porta_pc", 47989))}


def com_dmz(c, ip):
    """No cabo de rede da DMZ: o PC na rede do cabo entra como destino do MAC principal (antes dos outros)."""
    if not na_dmz(ip):
        return c
    mac, destinos = c["alvos"][0]
    if c["pc_cabo"] not in destinos:
        c = dict(c, alvos=[(mac, [c["pc_cabo"]] + destinos)] + c["alvos"][1:])
    return c


def pacote_magico(mac):
    b = bytes.fromhex(re.sub("[:-]", "", mac))
    return b"\xff" * 6 + b * 16


def mandar(c):
    enviados = []
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for mac, destinos in c["alvos"]:
            p = pacote_magico(mac)
            for d in destinos:
                for _ in range(3):  # UDP pode se perder: três vezes não custa nada
                    try:
                        s.sendto(p, (d, c["porta"]))
                    except OSError:
                        break  # um destino sem rota não impede os outros
                    time.sleep(0.1)
                enviados.append(f"{d}:{c['porta']} (...{mac[-5:]})")
    print("pacote mágico enviado para " + ", ".join(enviados))


def pc_no_ar(ip, porta, prazo=2.0):
    try:
        with socket.create_connection((ip, porta), timeout=prazo):
            return True
    except OSError:
        return False


def algum_no_ar(c, prazo=2.0):
    return any(pc_no_ar(p, c["porta_pc"], prazo) for p in c["pcs"])


def main(args):
    if "-h" in args or "--help" in args:
        print(__doc__)
        return 0
    meu_ip = ip_local()
    c = com_dmz(ler_conf(), meu_ip)
    rede = "cabo de rede (DMZ)" if na_dmz(meu_ip) else ("rede " + meu_ip.rsplit(".", 1)[0] + ".x" if meu_ip else "sem rede")
    if "--status" in args:
        print("celular: " + rede)
        for mac, ds in c["alvos"]:
            print(f"MAC ...{mac[-5:]} -> {ds} porta {c['porta']}")
        print("PC: " + ", ".join(f"{p}:{c['porta_pc']}" for p in c["pcs"]))
        return 0
    if c["pcs"] and algum_no_ar(c):
        print("o PC já está ligado (o Sunshine respondeu).")
        return 0
    mandar(c)
    if "--sem-esperar" in args or not c["pcs"]:
        return 0
    print("esperando o PC ligar (até 3 minutos)...", flush=True)
    fim = time.time() + 180
    while time.time() < fim:
        if algum_no_ar(c):
            print("PC ligado e o Sunshine no ar: pode abrir o Moonlight.")
            return 0
        time.sleep(5)
    print("o PC não respondeu em 3 minutos. SUSPENSO: confira o Wi-Fi do PC ligado na rede de casa. DESLIGADO de vez: "
          "precisa da regra do FortiGate e do Wake-on-LAN no BIOS.")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
