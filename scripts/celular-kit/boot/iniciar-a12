#!/data/data/com.termux/files/usr/bin/bash
# Termux:Boot roda isto quando o celular liga (copiado para ~/.termux/boot/): sobe o sshd (so 127.0.0.1) e o guarda da saida de internet, se ela estiver pedida.
# NAO usa termux-wake-lock (gastaria bateria). Este script fica de pe de proposito: enquanto ha uma tarefa viva, o servico do Termux segue em primeiro plano
# e o Android nao mata o sshd nem o guarda. Log: ~/.cache/saida/boot.log
PATH="$HOME/bin:/data/data/com.termux/files/usr/bin:$PATH"
LOG="$HOME/.cache/saida/boot.log"
mkdir -p "$HOME/.cache/saida"
{
  echo "$(date '+%Y-%m-%d %H:%M:%S') boot: inicio"
  pgrep -x sshd >/dev/null 2>&1 || sshd
  if pgrep -x sshd >/dev/null 2>&1; then s="sshd ok"; else s="sshd NAO subiu"; fi
  g=$(saida guarda 2>&1); rc=$?   # rc 1 = saida nao pedida (nada a vigiar) ou guarda que nao subiu: o texto de $g diz qual
  echo "$(date '+%Y-%m-%d %H:%M:%S') boot: $s; guarda: rc=$rc $(printf '%s' "$g" | tr '\n' ' ')"
  command -v guarda >/dev/null 2>&1 && echo "$(date '+%Y-%m-%d %H:%M:%S') boot: vigia de arquivos: $(guarda ligar 2>&1 | tr '\n' ' ')"
  # repasse do ARENA (10/11/2026): partida entre casas pelo codigo de 6 numeros; so sobe se estiver instalado
  [ -f "$HOME/arena-repasse/repasse_proprio.py" ] && command -v repasse >/dev/null 2>&1 && echo "$(date '+%Y-%m-%d %H:%M:%S') boot: $(repasse ligar 2>&1)"
  # sentinela do univo-sync (12/11/2026): a saude deste celular, uma amostra por minuto; so sobe se estiver instalado
  [ -f "$HOME/univo-sync/sentinela_a12.py" ] && command -v sentinela >/dev/null 2>&1 && echo "$(date '+%Y-%m-%d %H:%M:%S') boot: $(sentinela ligar 2>&1)"
  # ligar o PC de longe pelo Tailscale (Wake-on-LAN, 13/11/2026); so sobe com o ligar-pc instalado e a conf com a chave
  [ -f "$HOME/univo-sync/ligar_pc.py" ] && command -v ligar-pc >/dev/null 2>&1 && echo "$(date '+%Y-%m-%d %H:%M:%S') boot: $(ligar-pc servir-ligar 2>&1)"
  # vigia da TV (12/11/2026): captura de tela ativa = celular na proporcao da TV; parou = volta
  command -v cel >/dev/null 2>&1 && echo "$(date '+%Y-%m-%d %H:%M:%S') boot: $(cel tv vigia ligar 2>&1 | head -n 1)"
} >> "$LOG" 2>&1
# memoria do Univo: se alimenta sozinha (aparelho, apps, rotina, projetos do cartao e, com o PC no ar, o que o Claude fez)
alimenta() { command -v memoria >/dev/null 2>&1 && nice -n 15 timeout 600 memoria atualizar --auto >/dev/null 2>&1; }
( sleep 300; alimenta ) &
hora=0
while :; do
  sleep 3600
  hora=$((hora + 1)); [ $((hora % 6)) = 0 ] && alimenta
  # de hora em hora: se o Android tiver matado um dos dois, sobe de novo (nao faz rede e nao acorda o aparelho: o sleep congela com a CPU parada)
  pgrep -x sshd >/dev/null 2>&1 || sshd
  saida guarda >/dev/null 2>&1
  command -v guarda >/dev/null 2>&1 && guarda ligar >/dev/null 2>&1
  [ -f "$HOME/arena-repasse/repasse_proprio.py" ] && command -v repasse >/dev/null 2>&1 && repasse ligar >/dev/null 2>&1
  [ -f "$HOME/univo-sync/sentinela_a12.py" ] && command -v sentinela >/dev/null 2>&1 && sentinela ligar >/dev/null 2>&1
  [ -f "$HOME/univo-sync/ligar_pc.py" ] && command -v ligar-pc >/dev/null 2>&1 && ligar-pc servir-ligar >/dev/null 2>&1
  command -v cel >/dev/null 2>&1 && cel tv vigia ligar >/dev/null 2>&1
done
